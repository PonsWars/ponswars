node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.turbo/
*.tsbuildinfo

# Test / coverage
coverage/
.vitest/

# Environment — never commit real credentials
.env
.env.*
!.env.example

# Contracts (Foundry)
# lib/ is deliberately NOT ignored: forge-std is a git submodule, and the
# pinned commit is part of what makes a build reproducible.
contracts/out/
contracts/cache/
contracts/broadcast/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Local scratch
tmp/
.scratch/

# Byte-identical duplicate of the masterplan, kept locally only
_archive/

# Local scratch used while deriving golden values
.scratch/

# Vite build output
apps/web/dist/

# The private planning bundle. Kept on disk, never published.
#
# The masterplan carries the treasury wallet topology (§44.4) and the full
# security threat model (§45), and the visual pack is unreleased art direction.
# Neither belongs in a public repository before an independent contract review
# and launch. The code documents the rules it implements; these documents are
# where those rules were decided.
01_Masterplan/
03_Visual_Pack/
