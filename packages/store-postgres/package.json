{
  "name": "@ponswars/store-postgres",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A PostgreSQL adapter for the round store. Which managed provider hosts it is still OPEN; the schema is not.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@ponswars/auth": "workspace:*",
    "@ponswars/battle-engine": "workspace:*",
    "@ponswars/player-service": "workspace:*",
    "@ponswars/round-service": "workspace:*",
    "@ponswars/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@ponswars/battle-math": "workspace:*",
    "viem": "^2.56.3"
  }
}
