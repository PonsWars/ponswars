# PonsWars environment contract
#
# Generated by scripts/generate-env-example.mjs from the parameter table in
# packages/config. Do not edit by hand — run `node scripts/generate-env-example.mjs`.
#
# Every variable below is REQUIRED. Nothing here has a default: masterplan §102
# forbids inventing an OPEN value and shipping it as product policy, so startup
# fails with the full list of what is missing rather than guessing (§65.2).
#
# The values shown are placeholders and will not work. See docs/OPEN_PARAMETERS.md
# for what each one still needs decided.

# --------------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------------

# Runtime mode. Selects logging verbosity and safety checks.
NODE_ENV=development

# --------------------------------------------------------------------------
# Chain and contracts
# --------------------------------------------------------------------------

# Robinhood Chain network ID: 4663 mainnet or 46630 testnet. Per-environment;
# never inferred from the RPC response alone.
CHAIN_ID=<chain id>

# Robinhood Chain JSON-RPC endpoint (§59.3), on the CHAIN_ID network; startup
# refuses one on another chain. Vendor choice is OPEN.
# SECRET — never commit a real value and never log it.
RPC_URL=<rpc endpoint url>

# $WAR token. Genesis eligibility reads its balance (§6).
WAR_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# SPY reward token for distributions and the Secret vault (§17, §18).
SPY_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# SPY decimals. Required to convert the locked 0.2 SPY Secret reward into base
# units. Read from chain and configured explicitly — never assumed to be 18.
SPY_TOKEN_DECIMALS=<read from chain>

# $WAR decimals, for converting the 1,000,000 Genesis threshold (§6).
WAR_TOKEN_DECIMALS=<read from chain>

# RewardsDistributor contract, populated after deployment (§17).
REWARDS_DISTRIBUTOR_ADDRESS=0x0000000000000000000000000000000000000000

# SecretStockVault contract, populated after deployment (§18).
SECRET_STOCK_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# The private key holding RESERVER_ROLE on SecretStockVault, so a Secret
# reward is reserved before it is revealed (§8.4), or "disabled". Disabled,
# Secret results are off and their band deals Legendary (§8.3). Startup
# refuses a key without the role.
# SECRET — never commit a real value and never log it.
SECRET_RESERVER_KEY=disabled

# Least time between two market-indexer calls to RPC_URL. The public endpoint
# answers bursts with a challenge page; a vendor has a rate it bills or cuts
# at.
RPC_MIN_INTERVAL_MS=<required>

# --------------------------------------------------------------------------
# Storage
# --------------------------------------------------------------------------

# PostgreSQL connection string for authoritative game state (§21.3).
# SECRET — never commit a real value and never log it.
DATABASE_URL=postgres://user:password@localhost:5432/ponswars

# Redis connection string for hot state, pub/sub and locks (§21.3).
# SECRET — never commit a real value and never log it.
REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------------------
# Rewards
# --------------------------------------------------------------------------

# Minimum claimable allocation as a decimal SPY amount. BASELINE in the
# masterplan (0.001, §16.7) and still to be confirmed — amounts below it carry
# forward, so the figure decides who gets paid this window.
MIN_CLAIM_THRESHOLD_SPY=0.001

# --------------------------------------------------------------------------
# Market and chain feeds
# --------------------------------------------------------------------------

# Age at which a price sample becomes STALE and can void a live battle (§23.6,
# §4.4). A product decision, not a tuning knob.
PRICE_FEED_STALE_AFTER_MS=<calibrate per source>

# Age at which a volume sample becomes STALE (§23.3, §23.6).
VOLUME_FEED_STALE_AFTER_MS=<calibrate per source>

# Age at which Pons indexer data becomes STALE (§23.4, §23.6).
PONS_FEED_STALE_AFTER_MS=<calibrate per source>

# How far back from an instant DEX trades are pooled into one Stock Token
# price (§23.2). Longer is steadier and slower to follow the market.
MARKET_PRICE_WINDOW_MS=<required>

# Smallest trade, in USD, that counts towards a price or volume (§23.7). Below
# it a trade is dust — the cheapest way to push a thin pool.
MARKET_MIN_TRADE_USD=<required>

# How far from the Chainlink reference a single trade may be before it is
# dropped as an outlier (§23.7), in basis points.
MARKET_OUTLIER_BPS=<required>

# How far the DEX price may sit from the Chainlink reference before the feed
# is STALE and a live battle voids (§23.7, §4.4), in basis points. Must allow
# for the reference only updating on a 0.5% move.
MARKET_DIVERGENCE_BPS=<required>

# Age past which a Chainlink reference cannot vouch for a price (§23.7). The
# Robinhood feeds have a 24-hour heartbeat.
MARKET_REFERENCE_MAX_AGE_MS=<required>

# Fewest trades in the price window for a HEALTHY reading; fewer is DEGRADED
# (§23.6).
MARKET_MIN_WINDOW_TRADES=<required>

# How far back an asset’s own volatility is measured, which a battle’s return
# is divided by (§12.1).
MARKET_VOLATILITY_LOOKBACK_MS=<required>

# The smallest volatility a battle window may be given, in basis points
# (§12.1), so a still hour does not turn an ordinary move into many sigma.
MARKET_VOLATILITY_FLOOR_BPS=<required>

# How many earlier trading days relative volume is measured against (§12.2).
# The indexer keeps that much trading in memory.
MARKET_COMPARABLE_SESSIONS=<required>

# The smallest expected volume for a window, in USD (§12.2), so a ticker that
# barely traded last week does not make one trade today a surge.
MARKET_EXPECTED_VOLUME_FLOOR_USD=<required>

# US exchange holidays as comma-separated YYYY-MM-DD dates. No round opens
# while the market is shut (§23.8). Published by the exchange a year at a
# time; empty means none.
MARKET_HOLIDAYS=<required>

# Smallest Pons trade, in USD, that counts as qualified activity (§12.3,
# §75.3). TUNABLE: calibrated, not guessed.
PONS_MIN_ACTIVITY_USD=<required>

# How many same-sized Pons trades from one wallet count before the rest are a
# loop (§75.3). TUNABLE.
PONS_MAX_IDENTICAL_PER_WALLET=<required>

# Path to the JSON holding the engine tuning and confidence bands this
# deployment scores by (§59.4): the scoring divisors, momentum and victory
# thresholds, and the four confidence bands with their matchup gaps. §59.4
# treats the block as one decision, so it is one file rather than a dozen
# variables, and it is the file `tools/calibrate-market.mjs` measures a
# candidate as. No default: a service that invented a calibration would be
# shipping product policy (§102).
ENGINE_CALIBRATION_FILE=tools/calibration/initial-candidate.json

# Authoritative scoring tick interval. BASELINE: §12.5 and §23.1 say
# approximately one per second.
BATTLE_ENGINE_TICK_MS=1000

# --------------------------------------------------------------------------
# serving
# --------------------------------------------------------------------------

# Port the REST API binds (§47). A deployment fact: the same image runs behind
# different ingresses.
API_PORT=<required>

# Port the realtime gateway binds (§48). Separate from the API so the two can
# scale and fail independently.
GATEWAY_PORT=<required>

# Browser origins allowed to read the API (§47). Comma separated. An empty
# value is valid and means no browser may.
ALLOWED_ORIGINS=<required>

# Which market to score battles from (§59.3, §23.6): `onchain` reads Stock
# Token trading on Robinhood Chain mainnet, checked against Chainlink;
# `synthetic` generates prices and says so. No default — a deployment that
# scored real battles from made-up prices must not be one typo away.
MARKET_DATA_PROVIDER=<required>

# --------------------------------------------------------------------------
# auth
# --------------------------------------------------------------------------

# The origin a sign-in signature is bound to (§45.2). The message names its
# host, and a signature produced for one site must not authenticate at another
# — so this is the public URL of the client, not of the API.
AUTH_ORIGIN=<required>

# How long a sign-in challenge is worth signing (§45.2). OPEN: the masterplan
# says short-lived and names no figure. Long enough for a hardware wallet,
# short enough that a stolen unsigned challenge is worth little.
AUTH_CHALLENGE_TTL_MS=<required>

# How long a session lasts before the wallet is asked again (§45.2). OPEN, and
# the more consequential of the two: a session is a bearer credential, so this
# is how long a stolen one works.
AUTH_SESSION_TTL_MS=<required>
