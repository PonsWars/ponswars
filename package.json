{
  "name": "ponswars",
  "version": "0.0.0",
  "private": true,
  "description": "PonsWars \u2014 a persistent spatial market-war world driven by real market data",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --verbose && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bash scripts/verify.sh",
    "clean": "tsc --build --clean",
    "db:up": "docker compose -f infra/containers/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/containers/docker-compose.yml down",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:check": "node scripts/check-migrations.mjs",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "contracts:fmt": "forge fmt",
    "merkle:fixture": "node scripts/generate-merkle-fixture.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "replay": "node tools/replay-round.mjs",
    "audit:distribution": "node tools/verify-distribution.mjs",
    "audit:genesis": "node tools/audit-genesis.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "pgsql-parser": "^18.2.6",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
