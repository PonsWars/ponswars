{
  "name": "@ponswars/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The deployable service: round driver, REST API and realtime gateway in one process, wired from validated configuration.",
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@ponswars/api": "workspace:*",
    "@ponswars/auth": "workspace:*",
    "@ponswars/battle-engine": "workspace:*",
    "@ponswars/battle-math": "workspace:*",
    "@ponswars/config": "workspace:*",
    "@ponswars/gateway": "workspace:*",
    "@ponswars/market-data": "workspace:*",
    "@ponswars/round-service": "workspace:*",
    "@ponswars/shared-types": "workspace:*",
    "@ponswars/store-postgres": "workspace:*",
    "pg": "^8.16.4"
  },
  "devDependencies": {
    "@types/pg": "^8.15.7"
  }
}
