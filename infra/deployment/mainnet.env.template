# PonsWars on Robinhood Chain mainnet (4663) — one host, docker-compose.prod.yml
# with `--profile bundled-database --profile edge`.
#
# Copy to the checkout's `.env` on the host and replace every <…>. A value left
# in angle brackets is invalid on purpose: the server refuses to start and
# names it, rather than running on a placeholder (§65.2).
#
# Every line says where its value comes from:
#
#   FACT      true of mainnet or of this composition; not a choice
#   DECIDED   chosen, with the record that chose it
#   MEASURED  the value the market replay ran with (tools/calibration,
#             docs/OPEN_PARAMETERS.md §2) — CALIBRATE in the registry until a
#             clean week of tapes says otherwise
#   BASELINE  the masterplan's example value, still to be confirmed (§102)
#   PROPOSED  a starting value with its reason, for the founder to confirm
#   YOURS     only the founder can supply it
#
# `scripts/generate-env-example.mjs --check` fails when this file and the
# parameter table in packages/config disagree about which variables exist.

# --------------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------------

# FACT
NODE_ENV=production

# --------------------------------------------------------------------------
# Chain and contracts
# --------------------------------------------------------------------------

# FACT — Robinhood Chain mainnet. Never another chain.
CHAIN_ID=4663

# YOURS — the vendor endpoint (Alchemy Pay As You Go: its free tier caps
# eth_getLogs at 10 blocks, which cannot index this chain). SECRET.
RPC_URL=<alchemy endpoint url>

# YOURS — after the $WAR launch on Pons (LAUNCH.md step 6).
WAR_TOKEN_ADDRESS=<$WAR token address>

# FACT, once the token exists — read from the token on chain, never assumed.
# The server refuses to start if this disagrees with the chain.
WAR_TOKEN_DECIMALS=<read from the $WAR token>

# FACT — the SPY Stock Token (packages/chain/src/robinhood-market.ts).
SPY_TOKEN_ADDRESS=0x117cc2133c37B721F49dE2A7a74833232B3B4C0C

# FACT — read from the SPY token on mainnet, 2026-09-24.
SPY_TOKEN_DECIMALS=18

# FACT, once deployed (LAUNCH.md step 8, contracts/deployments/4663.json).
REWARDS_DISTRIBUTOR_ADDRESS=<RewardsDistributor address>
SECRET_STOCK_VAULT_ADDRESS=<SecretStockVault address>

# YOURS — the hot key holding the vault's reserver role (LAUNCH.md step 5), or
# `disabled`: Secret results off, their band deals Legendary (§8.3). SECRET.
SECRET_RESERVER_KEY=<reserver private key, or disabled>

# PROPOSED after measuring — the least time between indexer calls, chosen
# against the vendor's rate and bill in the first hour on it.
RPC_MIN_INTERVAL_MS=<measured against the vendor>

# --------------------------------------------------------------------------
# Storage — the bundled PostgreSQL and Redis
# --------------------------------------------------------------------------

# FACT — the bundled services' names on the compose network. The password is
# generated on the host (`openssl rand -hex 24`) and goes in both
# POSTGRES_PASSWORD and DATABASE_URL. SECRET.
#
# Empty here, not a placeholder: a placeholder is a working password once it
# reaches the database, and this file is public. Empty, Compose refuses to
# start the database until one is set.
DATABASE_URL=postgres://ponswars:<database password>@postgres:5432/ponswars
REDIS_URL=redis://redis:6379
POSTGRES_USER=ponswars
POSTGRES_PASSWORD=
POSTGRES_DB=ponswars

# --------------------------------------------------------------------------
# Rewards
# --------------------------------------------------------------------------

# BASELINE — the masterplan's example is 0.001 SPY (§16.7). YOURS to confirm:
# allocations below it carry forward, so it decides who is paid in a window.
MIN_CLAIM_THRESHOLD_SPY=<confirm: 0.001>

# --------------------------------------------------------------------------
# Market and chain feeds
# --------------------------------------------------------------------------

# DECIDED — fifteen minutes (docs/adr/0008-fifteen-minute-price-staleness-at-launch.md).
PRICE_FEED_STALE_AFTER_MS=900000

# MEASURED — every value below is tools/calibration/initial-candidate.json's.
VOLUME_FEED_STALE_AFTER_MS=60000
PONS_FEED_STALE_AFTER_MS=60000
MARKET_PRICE_WINDOW_MS=120000
MARKET_MIN_TRADE_USD=5
MARKET_OUTLIER_BPS=300
MARKET_DIVERGENCE_BPS=200
MARKET_REFERENCE_MAX_AGE_MS=93600000
MARKET_MIN_WINDOW_TRADES=2
MARKET_VOLATILITY_LOOKBACK_MS=1500000
MARKET_VOLATILITY_FLOOR_BPS=5
MARKET_COMPARABLE_SESSIONS=5
MARKET_EXPECTED_VOLUME_FLOOR_USD=1000
PONS_MIN_ACTIVITY_USD=1
PONS_MAX_IDENTICAL_PER_WALLET=5

# FACT — every full-day NYSE closure the exchange has published from today,
# read from nyse.com/trade/hours-calendars on 2026-09-26: the rest of 2026,
# then 2027 and 2028, with a weekend holiday on its observed weekday. Add 2029
# when it is published — a holiday missing here opens rounds that void
# (§23.8). Early closes are not closures and are not listed.
MARKET_HOLIDAYS=2026-11-26,2026-12-25,2027-01-01,2027-01-18,2027-02-15,2027-03-26,2027-05-31,2027-06-18,2027-07-05,2027-09-06,2027-11-25,2027-12-24,2028-01-17,2028-02-21,2028-04-14,2028-05-29,2028-06-19,2028-07-04,2028-09-04,2028-11-23,2028-12-25

# MEASURED — the engine tuning and confidence bands, from the checkout through
# the compose mount; the same file the replay ran.
ENGINE_CALIBRATION_FILE=/app/calibration/initial-candidate.json

# BASELINE — about one authoritative tick a second (§12.5, §23.1).
BATTLE_ENGINE_TICK_MS=1000

# --------------------------------------------------------------------------
# Serving — behind the edge (docs/operations/deployment.md, "The edge")
# --------------------------------------------------------------------------

# FACT — inside the compose network only; the edge is the public face.
API_PORT=3000
GATEWAY_PORT=3001

# FACT — one origin serves the page, the API and the socket.
ALLOWED_ORIGINS=https://<domain>

# FACT — the edge's fixed address, and nothing else.
API_TRUSTED_PROXIES=172.28.0.10

# FACT — score battles from Robinhood Chain's own market (ADR 0007).
MARKET_DATA_PROVIDER=onchain

# YOURS — an ntfy topic with a long random name, subscribed on your phone
# (LAUNCH.md step 10). SECRET: whoever knows the topic reads the alerts.
ALERT_WEBHOOK=ntfy+https://ntfy.sh/<long random topic>

# PROPOSED — thirty minutes. A round tied through every market component waits
# for a finalized block, which takes around twenty minutes; shorter would page
# on a legitimate tie.
ALERT_ROUND_STUCK_AFTER_MS=1800000

# --------------------------------------------------------------------------
# Wallet sign-in
# --------------------------------------------------------------------------

# FACT — the client's public origin; a signature is bound to it (§45.2).
AUTH_ORIGIN=https://<domain>

# PROPOSED — five minutes: time to read and confirm on a hardware wallet, and
# a stolen unsigned challenge is worthless soon after.
AUTH_CHALLENGE_TTL_MS=300000

# PROPOSED — a day. How long a stolen session works; rotation (§45.2) keeps a
# long visit signed in without making it longer.
AUTH_SESSION_TTL_MS=86400000

# PROPOSED — 60 requests a minute per address, so 30 sign-ins, bursting to the
# same. Generous on purpose: players behind one carrier-grade NAT share an
# address, and the limit exists to stop one machine spending every core (a
# verify is ~3.6 ms of CPU), not to ration players.
AUTH_RATE_LIMIT_REQUESTS=60
AUTH_RATE_LIMIT_WINDOW_MS=60000

# --------------------------------------------------------------------------
# The composition — the edge and the client build
# --------------------------------------------------------------------------

# YOURS — the domain players use, with its DNS pointing at this host and ports
# 80 and 443 open before the first start.
SITE_DOMAIN=<domain>

# FACT — compiled into the client; public the moment it ships.
VITE_API_URL=https://<domain>
VITE_WS_URL=wss://<domain>/ws
WEB_PORT=8080
